# Copy to `.env` and fill in. `.env` is gitignored; this example is committed.

# Spotify app client id (PKCE, no client secret). Create the app at
# https://developer.spotify.com/dashboard with redirect URI
# http://127.0.0.1:8765/callback and the Web API enabled.
SPOTIFY_CLIENT_ID=your_client_id_here

# Private data repo holding the cloud live buffer, e.g. warithr621/spotify-analysis-data.
# When both DATA_REPO and DATA_REPO_TOKEN are set, the local Refresh button pulls the
# cloud buffer instead of calling Spotify directly. Leave unset to keep the old local
# Spotify sync behavior.
DATA_REPO=

# Fine-grained PAT with Contents: Read on the data repo only (local pull).
DATA_REPO_TOKEN=
